# Dockerfile for Render deployment
# Lightweight FastAPI service for token prediction inference
# No PySpark/Java needed - uses pure Python for model loading

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dockerignore and then everything else
COPY .dockerignore.render .dockerignore

# Copy lightweight API requirements
COPY infra/requirements-api.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/           ./api/
COPY spark/         ./spark/
COPY monitoring/    ./monitoring/
COPY infra/         ./infra/
COPY optimizer.py   .

# Copy model artifacts (bundled with container - only 63KB)
COPY models/        ./models/

# Pre-download NLTK data
RUN python -c "import nltk; nltk.download('stopwords', quiet=True)"

# Render uses PORT environment variable
ENV PORT=10000
EXPOSE 10000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "10000"]
